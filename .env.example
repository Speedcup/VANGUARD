# ---- Discord ----
# Bot token from the Discord Developer Portal.
DISCORD_TOKEN=your-bot-token-here
# The single guild this bot serves. App commands are synced here for instant availability.
GUILD_ID=000000000000000000
# Role ID that gates all staff-only / management commands.
STAFF_ROLE_ID=000000000000000000

# ---- Channels ----
# Bug reports, suggestions, and help requests post as a NEW FORUM POST, so these
# should be FORUM channel IDs (each submission becomes its own thread). A plain
# text channel ID also works (submission posts as a message instead).
# Where bug reports are posted. Falls back to REPORTS_CHANNEL_ID if unset.
BUG_REPORT_CHANNEL_ID=000000000000000000
# Where suggestions are posted. Falls back to REPORTS_CHANNEL_ID if unset.
SUGGESTION_CHANNEL_ID=000000000000000000
# Where help requests are posted. Falls back to REPORTS_CHANNEL_ID if unset.
HELP_CHANNEL_ID=000000000000000000
# Shared fallback (forum or text) for any form type whose dedicated channel is unset.
REPORTS_CHANNEL_ID=000000000000000000
# Member join/leave/ban logs.
MEMBER_LOG_CHANNEL_ID=000000000000000000
# Honeypot catch / moderation log.
MOD_LOG_CHANNEL_ID=000000000000000000

# ---- Database ----
# PostgreSQL DSN. The `vector` (pgvector) extension must be installable on this database.
DATABASE_URL=postgresql://user:password@localhost:5432/vanguard

# ---- Embeddings ----
# Local sentence-transformers model used for semantic FAQ matching (384-dim).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- FAQ auto-responder defaults (seeded into bot_settings on first run) ----
# Cosine-similarity threshold [0..1]; matches below this stay silent.
FAQ_SIMILARITY_THRESHOLD=0.62
# RapidFuzz fast-path score threshold [0..100].
FAQ_FUZZY_THRESHOLD=90
# Per-user+channel cooldown (seconds) between auto-responses.
FAQ_COOLDOWN_SECONDS=60
# Minimum message length (characters) before the auto-responder considers a message.
FAQ_MIN_MESSAGE_LENGTH=15

# ---- Honeypot defaults (seeded into bot_settings on first run) ----
# Seconds to wait before auto-unbanning a softbanned (compromised) account.
HONEYPOT_SOFTBAN_SECONDS=60

# Optional: set to 1 to enable verbose debug logging.
DEBUG=0
